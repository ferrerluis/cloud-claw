# Managed by Terraform (local_file.repo_ssh_config) when generate_repo_ssh_config = true.
# Safe to edit manually, but terraform apply will overwrite this file.
Host cloud-claw
  HostName <instance_public_ip>
  User admin
  IdentityFile ./.ssh/id_ed25519_cloud_claw
  IdentitiesOnly yes
  ConnectTimeout 10
  ServerAliveInterval 20
  ServerAliveCountMax 3
  TCPKeepAlive yes
