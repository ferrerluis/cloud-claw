#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -n "${AGENT_STACK_SSH_KEY_PATH:-}" ]]; then
  KEY_PATH="$AGENT_STACK_SSH_KEY_PATH"
elif [[ -n "${OPENCLAW_SSH_KEY_PATH:-}" ]]; then
  KEY_PATH="$OPENCLAW_SSH_KEY_PATH"
elif [[ -f "$ROOT_DIR/.ssh/id_ed25519_agent_stack" || ! -f "$ROOT_DIR/.ssh/id_ed25519_cloud_claw" ]]; then
  KEY_PATH="$ROOT_DIR/.ssh/id_ed25519_agent_stack"
else
  KEY_PATH="$ROOT_DIR/.ssh/id_ed25519_cloud_claw"
fi

usage() {
  cat <<'EOF'
Usage: bin/agent-stack-ssh [--key <path>] [--host <user@ip>] [--] [remote-command...]

Defaults:
- host is read from: terraform output -raw ssh_command
- key is read from:  ./.ssh/id_ed25519_agent_stack, falling back to ./.ssh/id_ed25519_cloud_claw when only the legacy key exists
EOF
}

HOST_OVERRIDE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --key)
      KEY_PATH="${2:-}"
      if [[ -z "$KEY_PATH" ]]; then
        echo "error: --key requires a value" >&2
        exit 1
      fi
      shift 2
      ;;
    --host)
      HOST_OVERRIDE="${2:-}"
      if [[ -z "$HOST_OVERRIDE" ]]; then
        echo "error: --host requires a value" >&2
        exit 1
      fi
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

if [[ ! -f "$KEY_PATH" ]]; then
  echo "error: SSH private key not found at $KEY_PATH" >&2
  echo "run: bin/agent-stack-ssh-create" >&2
  exit 1
fi

TARGET=""
if [[ -n "$HOST_OVERRIDE" ]]; then
  TARGET="$HOST_OVERRIDE"
else
  SSH_CMD="$(terraform -chdir="$ROOT_DIR" output -raw ssh_command 2>/dev/null || true)"
  if [[ -z "$SSH_CMD" ]]; then
    echo "error: could not read terraform output 'ssh_command'" >&2
    echo "run: terraform apply (or pass --host user@ip)" >&2
    exit 1
  fi
  TARGET="${SSH_CMD#ssh }"
fi

exec ssh \
  -i "$KEY_PATH" \
  -o IdentitiesOnly=yes \
  -o ConnectTimeout=10 \
  -o ServerAliveInterval=20 \
  -o ServerAliveCountMax=3 \
  -o TCPKeepAlive=yes \
  "$TARGET" \
  "$@"
