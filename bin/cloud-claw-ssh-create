#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
KEY_DIR="$ROOT_DIR/.ssh"
KEY_NAME="${OPENCLAW_SSH_KEY_NAME:-id_ed25519_cloud_claw}"
KEY_PATH="$KEY_DIR/$KEY_NAME"
FORCE=0

usage() {
  cat <<'EOF'
Usage: bin/cloud-claw-ssh-create [--force] [--name <key-name>]

Creates a repo-local SSH keypair under ./.ssh and prints the public key
for terraform.tfvars (ssh_public_key).
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --force)
      FORCE=1
      shift
      ;;
    --name)
      KEY_NAME="${2:-}"
      if [[ -z "$KEY_NAME" ]]; then
        echo "error: --name requires a value" >&2
        exit 1
      fi
      KEY_PATH="$KEY_DIR/$KEY_NAME"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

if ! command -v ssh-keygen >/dev/null 2>&1; then
  echo "error: ssh-keygen not found in PATH" >&2
  exit 1
fi

mkdir -p "$KEY_DIR"
chmod 700 "$KEY_DIR"

if [[ -f "$KEY_PATH" || -f "$KEY_PATH.pub" ]]; then
  if [[ "$FORCE" -ne 1 ]]; then
    echo "error: key already exists at $KEY_PATH (use --force to overwrite)" >&2
    exit 1
  fi
  rm -f "$KEY_PATH" "$KEY_PATH.pub"
fi

COMMENT="cloud-claw@$(hostname)-$(date -u +%Y%m%dT%H%M%SZ)"
ssh-keygen -t ed25519 -N "" -C "$COMMENT" -f "$KEY_PATH" >/dev/null
chmod 600 "$KEY_PATH"
chmod 644 "$KEY_PATH.pub"

PUB_KEY="$(cat "$KEY_PATH.pub")"

cat <<EOF
Created repo-local SSH keypair:
  Private: $KEY_PATH
  Public:  $KEY_PATH.pub

Put this in terraform.tfvars:
  ssh_public_key = "$PUB_KEY"

Public key:
$PUB_KEY
EOF
